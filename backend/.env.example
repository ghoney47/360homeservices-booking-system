# ── Mode ──────────────────────────────────────────────────────────────────────
# "sheets"   → Google Sheets is the only data store (no database needed)
# "postgres" → original Postgres/Alembic behaviour
DB_MODE=sheets

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# IMPORTANT: replace localhost with your production domain before deploying.
ALLOWED_ORIGINS=https://yourdomain.com

# ── API Docs ───────────────────────────────────────────────────────────────────
# Set to "true" in development to enable /docs and /redoc.
# Leave unset or "false" in production.
ENABLE_DOCS=false

# ── Admin API key ──────────────────────────────────────────────────────────────
# Required to call any DB-backed admin route (/clients, /employees, /bookings, etc.).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=changeme

# ── Google Sheets ──────────────────────────────────────────────────────────────

# The Google Sheet that stores bookings (override to use a staging sheet).
GOOGLE_SHEET_ID=1fiT_JuS_oiETo9J0M7X3_SsiqZrlpwBiYDPVd6eYHpA

# LOCAL DEV — path to credentials.json downloaded from Google Cloud Console
# (OAuth 2.0 Client ID, Desktop app type)
# A token.json will be saved next to it after the first browser auth.
GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json

# Optional: override where the token file is saved (defaults to token.json
# in the same directory as GOOGLE_CREDENTIALS_PATH)
# GOOGLE_TOKEN_PATH=/path/to/token.json

# PRODUCTION — paste the contents of token.json here as a single-line string
# (set this in your hosting platform's environment variables dashboard)
# GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"...","scopes":[...]}

# ── Postgres (only needed when DB_MODE=postgres) ───────────────────────────────
# DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/primary
