# ── Mode ──────────────────────────────────────────────────────────────────────
# "sheets"   → Google Sheets is the only data store (no database needed)
# "postgres" → original Postgres/Alembic behaviour
DB_MODE=sheets

# ── Google Sheets credentials ─────────────────────────────────────────────────
# Option A (recommended for local dev): point to the JSON key file on disk
GOOGLE_CREDENTIALS_PATH=/path/to/sheets-access-key.json

# Option B: paste the entire JSON as a single-line string (good for deploy env vars)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"schedule-497019",...}

# ── Google Sheet target ────────────────────────────────────────────────────────
# These are already hard-coded in sheets_service.py — listed here for reference only.
# SHEET_ID=1fiT_JuS_oiETo9J0M7X3_SsiqZrlpwBiYDPVd6eYHpA
# WORKSHEET_NAME=Bookings

# ── Postgres (only needed when DB_MODE=postgres) ───────────────────────────────
# DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/primary
